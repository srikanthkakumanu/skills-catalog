{
  "$schema": "https://agentskills.io/schema/registry.json",
  "name": "skills-catalog",
  "version": "1.0.0",
  "description": "Production-grade Agent Skills Monorepo compatible with Antigravity 2.x, Claude Code, and OpenAI Codex following the open Agent Skills standard.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/srikanthkakumanu/skills-catalog",
  "repository": {
    "type": "git",
    "url": "https://github.com/srikanthkakumanu/skills-catalog.git"
  },
  "author": {
    "name": "Srikanth Kakumanu",
    "email": "srikanthkakumanu@users.noreply.github.com"
  },
  "compatibility": {
    "antigravity": ">=2.0.0",
    "claude_code": ">=1.0.0",
    "codex": ">=1.0.0",
    "python": ">=3.9"
  },
  "context_standards": {
    "progressive_loading": true,
    "subagent_isolation": true,
    "targeted_file_slicing": true,
    "compact_tool_outputs": true
  },
  "skills": [
    {
      "name": "brd",
      "version": "1.0.0",
      "path": "skills/brd",
      "entrypoint": "SKILL.md",
      "readme": "README.md",
      "description": "Produces a compact Business Requirements Document \u2014 domain, personas, use cases with happy/negative paths and acceptance criteria, and in/out-of-scope boundaries \u2014 with a mandatory self-check for unsupported framing claims, contradictions, and orphaned scope items. Pure functional scope: WHAT and WHO, never HOW.",
      "triggers": [
        "/brd",
        "generate brd",
        "create business requirements",
        "draft brd",
        "business requirements document",
        "requirements analysis"
      ],
      "runtimes": [
        "antigravity",
        "claude",
        "codex"
      ],
      "tags": [
        "requirements-engineering",
        "product-management",
        "babok",
        "ieee-29148",
        "business-analysis",
        "pure-functional-spec"
      ],
      "license": "Apache-2.0"
    },
    {
      "name": "req-nfr-analysis",
      "version": "1.0.0",
      "path": "skills/req-nfr-analysis",
      "entrypoint": "SKILL.md",
      "readme": "README.md",
      "description": "Normalizes a BRD's functional requirements and tags NFRs across 10 categories, flags inferred NFRs and contradictions, prioritizes each as hard-constraint or nice-to-have. Consumes BRD.md, produces req-nfr-analysis.md.",
      "triggers": [
        "/req-nfr-analysis",
        "analyze brd",
        "phase 1 requirements analysis",
        "extract nfr",
        "nfr analysis",
        "requirements analysis",
        "analyze requirements"
      ],
      "runtimes": [
        "antigravity",
        "claude",
        "codex"
      ],
      "tags": [
        "requirements-engineering",
        "nfr-analysis",
        "brd-analysis",
        "quality-attributes",
        "phase-1-analysis",
        "ieee-29148",
        "babok",
        "non-functional-requirements",
        "architecture-input"
      ],
      "license": "Apache-2.0"
    },
    {
      "name": "architecture-decisions",
      "version": "1.0.0",
      "path": "skills/architecture-decisions",
      "entrypoint": "SKILL.md",
      "readme": "README.md",
      "description": "Decides architecture style and agentic-AI fitness from a normalized requirement set and NFR analysis, in compact ADR format, gated behind a mandatory confirm/pending checkpoint. \"Not applicable\" is a valid agentic-AI verdict. Does not select stacks or component-level patterns.",
      "triggers": [
        "/architecture-decisions",
        "architecture decision",
        "architecture decisions",
        "should this be microservices",
        "should this be a monolith",
        "agentic ai fit",
        "agentic-ai fitness",
        "evaluate architecture",
        "design decisions",
        "phase 2 architecture",
        "adr",
        "generate adr"
      ],
      "runtimes": [
        "antigravity",
        "claude",
        "codex"
      ],
      "tags": [
        "architecture-design",
        "adr",
        "decision-records",
        "agentic-ai-fitness",
        "phase-2-analysis",
        "microservices",
        "monolith",
        "architecture-style",
        "event-driven",
        "serverless",
        "modular-monolith"
      ],
      "license": "Apache-2.0"
    },
    {
      "name": "detailed-design",
      "version": "1.0.0",
      "path": "skills/detailed-design",
      "entrypoint": "SKILL.md",
      "readme": "README.md",
      "description": "Turns confirmed architecture decisions into bounded contexts, microservice/design pattern selection, data architecture, API contracts, and a security model. Refuses to run against unconfirmed ADRs; traces every hard-constraint NFR to a design decision or flags it unaddressed.",
      "triggers": [
        "/detailed-design",
        "detailed design",
        "design the system",
        "detailed system design",
        "phase 4 design",
        "bounded contexts",
        "design patterns"
      ],
      "runtimes": [
        "antigravity",
        "claude",
        "codex"
      ],
      "tags": [
        "design",
        "bounded-contexts",
        "design-patterns",
        "microservices",
        "data-architecture",
        "api-contracts",
        "security-model",
        "phase-4-design",
        "nfr-traceability"
      ],
      "license": "Apache-2.0"
    },
    {
      "name": "tech-stack",
      "version": "1.0.0",
      "path": "skills/tech-stack",
      "entrypoint": "SKILL.md",
      "readme": "README.md",
      "description": "Selects full-stack technology choices per bounded context from detailed-design.md, citing catalog playbooks where they fit or presenting tradeoff options and stopping for confirmation when no playbook matches. Never decides off-catalog stacks unilaterally.",
      "triggers": [
        "/tech-stack",
        "tech stack selection",
        "technology selection",
        "choose technologies",
        "select stack",
        "tech stack",
        "choose tech stack",
        "phase 5 tech"
      ],
      "runtimes": [
        "antigravity",
        "claude",
        "codex"
      ],
      "tags": [
        "tech-stack",
        "technology-selection",
        "full-stack",
        "backend",
        "database",
        "frontend",
        "phase-5-selection",
        "playbook-catalog",
        "stack-tradeoffs"
      ],
      "license": "Apache-2.0"
    },
    {
      "name": "prd",
      "version": "1.0.0",
      "path": "skills/prd",
      "entrypoint": "SKILL.md",
      "readme": "README.md",
      "description": "Assembles a Product Requirements Document by pulling confirmed sections from BRD.md, req-nfr-analysis.md, architecture-decisions.md, detailed-design.md, and tech-stack.md per a section manifest. No new judgments — pure assembly only, with all unresolved items flagged in Open Items.",
      "triggers": [
        "/prd",
        "assemble prd",
        "product requirements document",
        "generate prd",
        "assemble product requirements",
        "phase 6 prd",
        "final prd"
      ],
      "runtimes": [
        "antigravity",
        "claude",
        "codex"
      ],
      "tags": [
        "prd",
        "product-requirements",
        "requirements-assembly",
        "phase-6-assembly",
        "documentation",
        "unified-spec",
        "open-items"
      ],
      "license": "Apache-2.0"
    }
  ]
}